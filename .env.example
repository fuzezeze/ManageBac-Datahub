# Copy to .env and replace every value before pointing this at a school.
# School timezone, ManageBac host, and retention are NOT confirmed defaults.

APP_ENV=development
SCHOOL_ID=school
SCHOOL_TIMEZONE=UTC
SCHOOL_TIMEZONE_CONFIRMED=false

CURSOR_SECRET=replace-with-a-long-random-string

DATABASE_URL_MIGRATE=mysql+pymysql://hub_migrate:hub_migrate_dev@127.0.0.1:3306/hub_ops?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://hub_sync:hub_sync_dev@127.0.0.1:3306/hub_ops?charset=utf8mb4
DATABASE_URL_API=mysql+pymysql://hub_api:hub_api_dev@127.0.0.1:3306/hub_ops?charset=utf8mb4
DATABASE_URL_AUTH=mysql+pymysql://hub_auth:hub_auth_dev@127.0.0.1:3306/hub_ops?charset=utf8mb4
DATABASE_URL_ADMIN=mysql+pymysql://hub_admin:hub_admin_dev@127.0.0.1:3306/hub_ops?charset=utf8mb4
DATABASE_URL_ANALYTICS=mysql+pymysql://hub_analytics:hub_analytics_dev@127.0.0.1:3306/hub_analytics?charset=utf8mb4
# Set this to the RDS CA bundle before connecting to Aliyun RDS. Leave empty for local MySQL.
DATABASE_SSL_CA=

# fixture | token | oauth
# production refuses fixture unless MB_ALLOW_FIXTURE=true
MB_AUTH_MODE=fixture
MB_API_BASE_URL=
MB_API_PREFIX=/v2p3
MB_TOKEN=
MB_CLIENT_ID=
MB_CLIENT_SECRET=
MB_RATE_LIMIT_PER_MINUTE=180
MB_ALLOW_FIXTURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave empty until the school approves a retention period. Empty means do not delete.
RAW_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

ATTENDANCE_LOOKBACK_DAYS=7
FRESHNESS_HOURS=36
ATTENDANCE_FRESHNESS_HOURS=6
STRICT_FRESHNESS=false
